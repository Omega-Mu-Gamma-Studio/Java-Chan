 /**
  * EmphasisText.css
  *
- * Four emphasis categories, each mapped to an existing theme color so this
- * stays visually consistent with the rest of the app rather than introducing
- * a new palette. Each category is a genuinely different treatment (color +
- * weight, sometimes style), not just "bold" repeated four times — the point
- * is a skimming reader can tell the categories apart at a glance.
+ * Four emphasis categories — the "Geronimo Stilton effect": each one reads
+ * as a genuinely different typographic event, not just a recolored word.
+ * Still built entirely from existing theme tokens, so every shop-unlockable
+ * theme (Sakura/Neon/Dusk/Golden Hour) repaints these correctly too.
  */
 
 .emphasis-text {
   display: contents;
 }
 
+.emphasis-text .emphasis-term,
+.emphasis-text .emphasis-warn,
+.emphasis-text .emphasis-key,
+.emphasis-text .emphasis-fun {
+  display: inline-block;
+  transform-origin: center bottom;
+  cursor: default;
+}
+
 /* [[term:...]] — new vocabulary, first appearance of a concept name.
-   Blue, since it reads as "informational" rather than urgent. */
+   Rounded display font (matches Java-chan's own lettering) + a hand-drawn
+   wavy underline, like a word freshly circled in a storybook. */
 .emphasis-term {
+  font-family: var(--font-display);
   color: var(--color-blue-light);
-  font-weight: 600;
+  font-size: 1.02em;
+  text-decoration: underline wavy;
+  text-decoration-color: var(--color-blue);
+  text-underline-offset: 3px;
 }
 
 /* [[warn:...]] — gotchas, common mistakes, "this bites people."
-   Warm/error-adjacent so it reads as "pay attention" without being alarming. */
+   Bigger, bolder, with a little "!!" callout — reads like a shout on the page. */
 .emphasis-warn {
   color: var(--color-warning);
-  font-weight: 700;
+  font-weight: 800;
+  font-size: 1.08em;
+  letter-spacing: 0.01em;
+}
+
+.emphasis-warn::before {
+  content: '⚠ ';
+  font-size: 0.85em;
 }
 
 /* [[key:...]] — the one idea in this paragraph worth remembering.
-   Pink, matching the mascot's own accent color — "this is the important bit." */
+   Pink, matching the mascot's accent — plus a highlighter-marker stroke
+   behind the text, like it's been dragged over with a real highlighter. */
 .emphasis-key {
+  position: relative;
   color: var(--color-pink-light);
-  font-weight: 700;
+  font-weight: 800;
+  font-size: 1.05em;
+  padding: 0 3px;
+  z-index: 0;
+}
+
+.emphasis-key::before {
+  content: '';
+  position: absolute;
+  inset: 12% -2px 8%;
+  background: var(--color-pink-glow);
+  border-radius: var(--radius-sm);
+  z-index: -1;
+  transform: rotate(-0.6deg);
 }
 
 /* [[fun:...]] — trivia / lighter aside, distinct from the teaching voice.
-   Purple + italic so Phase 5's trivia beat reads as tonally separate. */
+   Purple, italic, and stamped in at a slight tilt — like a doodle in the
+   margin rather than a line of the main text. */
 .emphasis-fun {
   color: var(--color-purple-light);
   font-style: italic;
-  font-weight: 600;
+  font-weight: 700;
+}
+
+.emphasis-fun::after {
+  content: ' ✨';
+  font-style: normal;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .emphasis-text .emphasis-term,
+  .emphasis-text .emphasis-warn,
+  .emphasis-text .emphasis-key,
+  .emphasis-text .emphasis-fun {
+    transform: none !important;
+  }
 }
